<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <EditText android:id="@+id/d_drug" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="drug"/>
    <EditText android:id="@+id/d_dose" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="dose"/>
    <EditText android:id="@+id/d_route" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="route"/>
</LinearLayout>
